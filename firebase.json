{
  "hosting": {
    "target": "prosper",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" }
    ]
  }
}