{
  "hosting": {
    "target": "prosper",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.py",
      "**/*.pyc",
      "**/__pycache__/**",
      "**/*.log",
      "debug_*.png",
      "dash_live.html",
      "Dockerfile",
      "requirements.txt",
      "README.md",
      "LICENSE",
      "all_env.yaml"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" }
    ]
  }
}